# TuitionHub API configuration. Placeholders and local Docker defaults only; never commit real
# values. The API reads environment variables (it does not load this file itself): export them in
# your shell, put overrides in the git-ignored backend/.env.local for `make backend-dev`, or set
# them in your hosting platform. Full reference: docs/LOCAL_SETUP.md#environment-variables

# --- Required ---------------------------------------------------------------------------------

# go-sql-driver DSN. Local Docker default below. TiDB Cloud (production) needs port 4000 and TLS:
#   USER:PASSWORD@tcp(HOST:4000)/tuitionhub?parseTime=true&charset=utf8mb4&loc=UTC&tls=true
DATABASE_URL=tuitionhub:tuitionhub@tcp(127.0.0.1:3306)/tuitionhub?parseTime=true&charset=utf8mb4&loc=UTC

# HMAC key for access tokens: at least 32 random characters, unique per environment.
# Generate one with: openssl rand -base64 48
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters

# --- Environment and HTTP ---------------------------------------------------------------------

# "production" hides development-only responses (reset/verification tokens) and enables release mode.
APP_ENV=development
# Listen address. When empty, the API uses :$PORT (set by Vercel and similar hosts), else :8080.
HTTP_ADDR=:8080
# PORT=
# true behind HTTPS so the session cookie is Secure.
COOKIE_SECURE=false

# --- Sessions ---------------------------------------------------------------------------------

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
# How long a just-rotated refresh token may be presented again before reuse is treated as theft
# (covers navigation and multi-tab races).
REFRESH_REUSE_GRACE=20s

# --- Uploads ----------------------------------------------------------------------------------

# disk: files under DOCUMENT_DIR. database: the stored_files table (hosts without a persistent
# disk, such as Vercel).
FILE_STORAGE=disk
DOCUMENT_DIR=private_documents
# Per-file limit in MB. Use 4 on Vercel (4.5 MB request limit) and set VITE_MAX_UPLOAD_MB to match.
MAX_UPLOAD_MB=10

# --- Abuse protection -------------------------------------------------------------------------

# Failed logins per email+IP and per IP in 15 minutes; register / password-reset / verify-email
# calls per IP per hour.
LOGIN_LIMIT_PER_ACCOUNT=5
LOGIN_LIMIT_PER_IP=50
SIGNUP_LIMIT_PER_IP=20
# Comma-separated reverse-proxy addresses allowed to set X-Forwarded-For. Leave empty unless the
# API runs behind a proxy you control.
TRUSTED_PROXIES=
# Header holding the real client IP set by the hosting edge (X-Real-IP on Vercel). Leave empty
# unless every request passes through that edge.
CLIENT_IP_HEADER=

# --- Database pool ----------------------------------------------------------------------------

# Per API process. Idle defaults to the open limit so connections are reused under load.
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5m

# --- First administrator (cmd/bootstrap-admin only) -------------------------------------------

# Set only in the shell that runs `go run ./cmd/bootstrap-admin`, then unset it. Never store a
# real value in a file.
# ADMIN_BOOTSTRAP_PASSWORD=
