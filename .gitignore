# Platform-managed agentplat state, not project source. In the
# client-initiated single-repo workspace layout (make's `Path: "."` spec) the
# repo root IS the workspace root, so these land inside this repo rather than
# beside it.
/.plugins/
/.opencode-skills/

# Backend build output (Air) and private verification uploads. Uploaded
# identity documents must never be committed.
backend/tmp/
backend/private_documents/
private_documents/

# Local database backups contain personal data and password hashes.
backend/backups/

# Local assistant and editor tooling (preview launch configs, session files).
.claude/

# macOS folder metadata
.DS_Store
