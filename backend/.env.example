APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=tuitionhub:tuitionhub@tcp(127.0.0.1:3306)/tuitionhub?parseTime=true&charset=utf8mb4&loc=UTC
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
COOKIE_SECURE=false

# Deployment-only initial administrator bootstrap password. Do not commit a
# real value. Set it only in the shell that runs the bootstrap CLI, then unset
# it immediately afterward. Local OS access and database credentials authorize
# this deployment-only command.
DOCUMENT_DIR=private_documents

# Abuse limits (defaults shown). Failed logins per email+IP and per IP in 15
# minutes; register / password-reset / verify-email calls per IP per hour.
LOGIN_LIMIT_PER_ACCOUNT=5
LOGIN_LIMIT_PER_IP=50
SIGNUP_LIMIT_PER_IP=20

# Comma-separated reverse-proxy addresses allowed to set X-Forwarded-For.
# Leave empty unless the API runs behind a proxy you control.
TRUSTED_PROXIES=

# How long a just-rotated refresh token may be presented again before reuse is
# treated as theft (covers navigation and multi-tab races).
REFRESH_REUSE_GRACE=20s
