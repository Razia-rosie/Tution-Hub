# Website (Vite) settings. Copy to `.env.local` (git-ignored) to override them locally;
# on Vercel set them as project environment variables. Placeholders only.

# Per-file upload limit shown and checked in the browser, in MB. Must match the API's
# MAX_UPLOAD_MB (backend/.env.example). Default 10; 4 on Vercel.
VITE_MAX_UPLOAD_MB=10

# Development server only: where Vite proxies /api (default http://localhost:8080) and
# which port it listens on. These are read from the shell, not from this file:
#   API_PROXY_TARGET=http://localhost:8090 PORT=5174 pnpm dev
